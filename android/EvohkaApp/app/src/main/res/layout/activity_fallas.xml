<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_title_evohka"
        android:gravity="center"
        android:padding="10dp"
        android:text="Fallas del inmueble"
        android:textColor="#170E0E"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnReportarFalla"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_button_evohka"
        android:backgroundTint="@null"
        android:text="Reportar una falla"
        android:textAllCaps="false"
        android:textColor="#170E0E"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtEstadoFallas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Consultando fallas..."
        android:textColor="#666666" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/contenedorFallas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp" />
    </ScrollView>
</LinearLayout>
