<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/evohka_screen_padding"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/evohka_screen_padding"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_title_evohka"
            android:gravity="center"
            android:padding="10dp"
            android:text="Registrar pago"
            android:textColor="#170E0E"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPagoContrato"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Contrato"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etFechaPago"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_evohka"
            android:clickable="true"
            android:focusable="false"
            android:hint="Fecha del pago"
            android:paddingHorizontal="14dp"
            android:textColor="#202020"
            android:textColorHint="#777777" />

        <EditText
            android:id="@+id/etMontoPago"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_evohka"
            android:hint="Monto"
            android:inputType="numberDecimal"
            android:paddingHorizontal="14dp"
            android:textColor="#202020"
            android:textColorHint="#777777" />

        <EditText
            android:id="@+id/etMetodoPago"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_evohka"
            android:hint="Método de pago"
            android:inputType="textCapSentences"
            android:maxLength="50"
            android:paddingHorizontal="14dp"
            android:textColor="#202020"
            android:textColorHint="#777777" />

        <EditText
            android:id="@+id/etObservacionesPago"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_evohka"
            android:gravity="top|start"
            android:hint="Observaciones (máximo 55 caracteres)"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="55"
            android:padding="14dp"
            android:textColor="#202020"
            android:textColorHint="#777777" />

        <Button
            android:id="@+id/btnGuardarPago"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_evohka"
            android:backgroundTint="@null"
            android:text="Guardar pago"
            android:textAllCaps="false"
            android:textColor="#170E0E"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCancelarPago"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_secondary_evohka"
            android:backgroundTint="@null"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="#202020" />

    </LinearLayout>
</ScrollView>
