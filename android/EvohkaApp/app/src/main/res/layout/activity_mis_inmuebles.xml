<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/evohka_screen_padding"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/evohka_screen_padding"
        android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_title_evohka"
        android:gravity="center"
        android:padding="10dp"
        android:text="Mis inmuebles"
        android:textColor="#170E0E"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtEstadoCarga"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Cargando inmuebles..."
        android:textColor="#666666"
        android:textSize="14sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/contenedorInmuebles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <Button
        android:id="@+id/btnPublicarNuevo"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_evohka"
        android:backgroundTint="@null"
        android:text="Publicar nuevo inmueble"
        android:textAllCaps="false"
        android:textColor="#170E0E"
        android:textSize="16sp"
        android:textStyle="bold" />

    </LinearLayout>

    <include layout="@layout/view_navegacion_propietario" />

</LinearLayout>
