<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="30dp"
        android:paddingEnd="28dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="EVOHKA"
            android:textColor="#CE74FF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_title_evohka"
            android:gravity="center"
            android:padding="10dp"
            android:text="Editar inmueble"
            android:textColor="#170E0E"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Actualiza la información registrada"
            android:textColor="#666666"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_titulo"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_input_evohka"
            android:hint="Título del inmueble"
            android:inputType="textCapSentences"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <EditText
            android:id="@+id/et_tipo_inmueble"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input_evohka"
            android:hint="Tipo de inmueble"
            android:inputType="textCapWords"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <EditText
            android:id="@+id/et_direccion"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input_evohka"
            android:hint="Dirección"
            android:inputType="textPostalAddress"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <EditText
            android:id="@+id/et_barrio"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input_evohka"
            android:hint="Barrio"
            android:inputType="textCapWords"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <EditText
            android:id="@+id/et_ciudad"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input_evohka"
            android:hint="Ciudad"
            android:inputType="textCapWords"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <EditText
            android:id="@+id/et_canon"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input_evohka"
            android:hint="Canon mensual"
            android:inputType="numberDecimal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <EditText
            android:id="@+id/et_habitaciones"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input_evohka"
            android:hint="Número de habitaciones"
            android:inputType="number"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <EditText
            android:id="@+id/et_banos"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input_evohka"
            android:hint="Número de baños"
            android:inputType="number"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <Button
            android:id="@+id/btn_actualizar_inmueble"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_evohka"
            android:backgroundTint="@null"
            android:text="Guardar cambios"
            android:textAllCaps="false"
            android:textColor="#170E0E"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_cancelar_edicion"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_evohka"
            android:backgroundTint="@null"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="#202020" />

    </LinearLayout>

</ScrollView>
