<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="#FFFFFF"
    android:elevation="8dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingTop="4dp">

    <TextView
        android:id="@+id/navPropietarioInicio"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:contentDescription="Inicio"
        android:focusable="true"
        android:gravity="center"
        android:text="⌂"
        android:textColor="#888888"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/navPropietarioInmuebles"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:contentDescription="Mis inmuebles"
        android:focusable="true"
        android:gravity="center"
        android:text="⌕"
        android:textColor="#888888"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/navPropietarioSolicitudes"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:contentDescription="Solicitudes"
        android:focusable="true"
        android:gravity="center"
        android:text="☷"
        android:textColor="#888888"
        android:textSize="25sp" />

    <TextView
        android:id="@+id/navPropietarioContratos"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:contentDescription="Contratos"
        android:focusable="true"
        android:gravity="center"
        android:text="□"
        android:textColor="#888888"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/navPropietarioNotificaciones"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:contentDescription="Notificaciones"
        android:focusable="true"
        android:gravity="center"
        android:text="♙"
        android:textColor="#888888"
        android:textSize="25sp" />

</LinearLayout>
