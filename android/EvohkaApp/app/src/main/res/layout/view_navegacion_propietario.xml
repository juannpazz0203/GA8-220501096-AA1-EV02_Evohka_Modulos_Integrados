<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="#FFFFFF"
    android:elevation="8dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/navPropietarioInicio"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:contentDescription="Inicio"
        android:focusable="true"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="⌂&#10;Inicio"
        android:textColor="#888888"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/navPropietarioInmuebles"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:contentDescription="Mis inmuebles"
        android:focusable="true"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="⌕&#10;Inmuebles"
        android:textColor="#888888"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/navPropietarioSolicitudes"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:contentDescription="Solicitudes"
        android:focusable="true"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="☷&#10;Solicitudes"
        android:textColor="#888888"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/navPropietarioContratos"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:contentDescription="Contratos"
        android:focusable="true"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="□&#10;Contratos"
        android:textColor="#888888"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/navPropietarioNotificaciones"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:contentDescription="Notificaciones"
        android:focusable="true"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="●&#10;Alertas"
        android:textColor="#888888"
        android:textSize="12sp" />

</LinearLayout>
