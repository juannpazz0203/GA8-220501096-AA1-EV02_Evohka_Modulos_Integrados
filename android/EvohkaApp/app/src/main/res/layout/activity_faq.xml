<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/evohka_screen_padding"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="@dimen/evohka_screen_padding"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_title_evohka"
        android:gravity="center"
        android:padding="10dp"
        android:text="Ayuda EVOHKA"
        android:textColor="#170E0E"
        android:textSize="20sp"
        android:textStyle="bold" />

    <WebView
        android:id="@+id/webFaq"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
