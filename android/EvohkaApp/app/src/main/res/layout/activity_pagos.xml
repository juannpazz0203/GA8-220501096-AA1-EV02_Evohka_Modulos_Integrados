<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/evohka_screen_padding"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/evohka_screen_padding"
        android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_title_evohka"
        android:gravity="center"
        android:padding="10dp"
        android:text="Historial de pagos"
        android:textColor="#170E0E"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtEstadoPagos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Cargando pagos..."
        android:textColor="#666666"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnRegistrarPago"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_evohka"
        android:backgroundTint="@null"
        android:text="Registrar pago"
        android:textAllCaps="false"
        android:textColor="#170E0E"
        android:textStyle="bold"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/contenedorPagos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp" />
    </ScrollView>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/contenedorNavegacionPagos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
