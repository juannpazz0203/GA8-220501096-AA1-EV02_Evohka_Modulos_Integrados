<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/evohka_screen_padding"
        android:paddingTop="35dp"
        android:paddingEnd="@dimen/evohka_screen_padding"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_title_evohka"
            android:gravity="center"
            android:text="Publicar inmueble"
            android:textColor="@color/evohka_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Completa la información del inmueble"
            android:textColor="@color/evohka_text_secondary"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/et_titulo"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_input_evohka"
            android:hint="Título del inmueble"
            android:inputType="textCapSentences"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <EditText
            android:id="@+id/et_tipo_inmueble"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_evohka"
            android:hint="Tipo de inmueble"
            android:inputType="textCapWords"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <EditText
            android:id="@+id/et_direccion"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_evohka"
            android:hint="Dirección"
            android:inputType="textPostalAddress"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <EditText
            android:id="@+id/et_barrio"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_evohka"
            android:hint="Barrio"
            android:inputType="textCapWords"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <EditText
            android:id="@+id/et_ciudad"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_evohka"
            android:hint="Ciudad"
            android:inputType="textCapWords"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <EditText
            android:id="@+id/et_canon"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_evohka"
            android:hint="Canon mensual"
            android:inputType="numberDecimal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <EditText
            android:id="@+id/et_habitaciones"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_evohka"
            android:hint="Número de habitaciones"
            android:inputType="number"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <EditText
            android:id="@+id/et_banos"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_evohka"
            android:hint="Número de baños"
            android:inputType="number"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <Button
            android:id="@+id/btn_guardar_inmueble"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_button_evohka"
            android:backgroundTint="@null"
            android:text="Publicar inmueble"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_cancelar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_secondary_evohka"
            android:backgroundTint="@null"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="#202020" />

    </LinearLayout>

</ScrollView>
