<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="40dp"
            android:paddingBottom="25dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textAlignment="center"
                android:textColor="#4776FF"
                android:textSize="48sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-10dp"
                android:text="EVOHKA"
                android:textAlignment="center"
                android:textColor="#4776FF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#CC66F4"
                android:clickable="false"
                android:focusable="false"
                android:text="BIENVENIDO"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSaludoPropietario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Hola, usuario 👋"
                android:textColor="#202020"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Resumen de tu actividad"
                android:textColor="#202020"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/txtMensajesSinLeer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="□   Mensajes sin leer: 0"
                android:textColor="#333333"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnMisInmuebles"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="#E0E0E0"
                android:text="Mis inmuebles"
                android:textAllCaps="false"
                android:textColor="#202020"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSolicitudes"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="15dp"
                android:backgroundTint="#E0E0E0"
                android:text="Solicitudes nuevas: 0"
                android:textAllCaps="false"
                android:textColor="#202020"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnVisitas"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="15dp"
                android:backgroundTint="#E0E0E0"
                android:text="Visitas este mes: 0"
                android:textAllCaps="false"
                android:textColor="#202020"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPublicarInmueble"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="25dp"
                android:backgroundTint="#CC66F4"
                android:text="Publicar nuevo inmueble"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="15dp"
                android:backgroundTint="#E0E0E0"
                android:text="Cerrar sesión"
                android:textAllCaps="false"
                android:textColor="#202020"
                android:textSize="15sp" />

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂"
            android:textColor="#000000"
            android:textSize="26sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌕"
            android:textColor="#AAAAAA"
            android:textSize="26sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="☷"
            android:textColor="#AAAAAA"
            android:textSize="25sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="□"
            android:textColor="#AAAAAA"
            android:textSize="24sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♙"
            android:textColor="#AAAAAA"
            android:textSize="25sp" />

    </LinearLayout>

</LinearLayout>