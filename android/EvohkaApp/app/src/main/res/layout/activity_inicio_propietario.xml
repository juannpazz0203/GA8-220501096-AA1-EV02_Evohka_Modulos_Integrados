<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/evohka_surface"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/evohka_screen_padding"
            android:paddingTop="20dp"
            android:paddingEnd="@dimen/evohka_screen_padding"
            android:paddingBottom="28dp">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Logo EVOHKA"
                android:scaleType="centerInside"
                android:src="@drawable/evohka_logo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_title_evohka"
                android:gravity="center"
                android:text="Inicio propietario"
                android:textColor="@color/evohka_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSaludoPropietario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Hola, usuario 👋"
                android:textColor="@color/evohka_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Gestiona tus arriendos desde un solo lugar"
                android:textColor="@color/evohka_text_secondary"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_evohka"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resumen de actividad"
                    android:textColor="@color/evohka_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtMensajesSinLeer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="●  Mensajes sin leer: 0"
                    android:textColor="@color/evohka_primary_dark"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Accesos principales"
                android:textColor="@color/evohka_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMisInmuebles"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary_evohka"
                    android:backgroundTint="@null"
                    android:text="⌂  Mis inmuebles"
                    android:textAllCaps="false"
                    android:textColor="@color/evohka_text"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSolicitudes"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary_evohka"
                    android:backgroundTint="@null"
                    android:text="☷  Solicitudes"
                    android:textAllCaps="false"
                    android:textColor="@color/evohka_text"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnContratos"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary_evohka"
                    android:backgroundTint="@null"
                    android:text="□  Contratos"
                    android:textAllCaps="false"
                    android:textColor="@color/evohka_text"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPagos"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary_evohka"
                    android:backgroundTint="@null"
                    android:text="$  Pagos"
                    android:textAllCaps="false"
                    android:textColor="@color/evohka_text"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFallas"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary_evohka"
                    android:backgroundTint="@null"
                    android:text="△  Fallas"
                    android:textAllCaps="false"
                    android:textColor="@color/evohka_text"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnConversaciones"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary_evohka"
                    android:backgroundTint="@null"
                    android:text="□  Mensajes"
                    android:textAllCaps="false"
                    android:textColor="@color/evohka_text"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Más herramientas"
                android:textColor="@color/evohka_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnReporteIngresos"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_secondary_evohka"
                android:backgroundTint="@null"
                android:text="Reporte de ingresos"
                android:textAllCaps="false"
                android:textColor="@color/evohka_text" />

            <Button
                android:id="@+id/btnNotificaciones"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_secondary_evohka"
                android:backgroundTint="@null"
                android:text="Notificaciones"
                android:textAllCaps="false"
                android:textColor="@color/evohka_text" />

            <Button
                android:id="@+id/btnFaq"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_secondary_evohka"
                android:backgroundTint="@null"
                android:text="Ayuda y preguntas frecuentes"
                android:textAllCaps="false"
                android:textColor="@color/evohka_text" />

            <Button
                android:id="@+id/btnPublicarInmueble"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_button_evohka"
                android:backgroundTint="@null"
                android:text="Publicar nuevo inmueble"
                android:textAllCaps="false"
                android:textColor="@color/evohka_text"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_secondary_evohka"
                android:backgroundTint="@null"
                android:text="Cerrar sesión"
                android:textAllCaps="false"
                android:textColor="@color/evohka_danger" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_navegacion_propietario" />
</LinearLayout>
