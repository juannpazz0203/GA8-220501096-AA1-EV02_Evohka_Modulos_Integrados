        <activity
            android:name=".PropiedadesDisponiblesActivity"
            android:exported="false" />
        <activity
            android:name=".EditarInmuebleActivity"
            android:exported="false" />
        <activity
            android:name=".PublicarInmuebleActivity"
            android:exported="false" />
        <activity
            android:name=".MisInmueblesActivity"
            android:exported="false" />
        <activity
            android:name=".InicioPropietarioActivity"
            android:exported="false" />
        <activity android:name=".RegistroActivity" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
