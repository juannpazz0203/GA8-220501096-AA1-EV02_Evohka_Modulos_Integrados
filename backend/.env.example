# Servidor
PORT=3000

# MySQL. Reemplace usuario y contraseña únicamente en backend/.env.
DB_HOST=localhost
DB_PORT=3306
DB_USER=REEMPLACE_CON_USUARIO_MYSQL
DB_PASSWORD=
DB_NAME=gestion_arriendos

# JWT: obligatorio, aleatorio y de al menos 32 bytes UTF-8.
# Se deja vacío deliberadamente para que una copia sin configurar falle.
JWT_SECRET=

# Esquema RNF03 final.
EVOHKA_SESIONES_VERSIONADAS_ACTIVAS=true
EVOHKA_BCRYPT_COSTO=12

# La transición para JWT antiguos debe permanecer desactivada en instalaciones
# nuevas. Solo se habilita temporalmente durante una migración planificada.
EVOHKA_JWT_TRANSICION_LEGACY_ACTIVA=false
EVOHKA_JWT_TRANSICION_LEGACY_HASTA=

# Recuperación de contraseña. Mantenga false hasta configurar todos los campos
# privados y haber aplicado la migración 003.
EVOHKA_RECUPERACION_ACTIVA=false
EVOHKA_RECUPERACION_PEPPER=
EVOHKA_SMTP_HOST=smtp.gmail.com
EVOHKA_SMTP_PORT=465
EVOHKA_SMTP_SECURE=true
EVOHKA_SMTP_USUARIO=
EVOHKA_SMTP_PASSWORD_APLICACION=
EVOHKA_SMTP_REMITENTE=

# No agregue aquí las confirmaciones de migración. Son variables de un solo uso
# que deben inyectarse únicamente durante una operación autorizada.
